NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://user:password@localhost:5432/magazine_forum
# Render internal PostgreSQL only: require TLS but allow its self-signed certificate.
# DATABASE_SSL_MODE=require
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=10000
PG_READY_TIMEOUT_MS=1500
SHUTDOWN_GRACE_MS=25000
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=editor
ADMIN_PASSWORD=replace-with-a-long-unique-password
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=klass-2k26/submissions
DELETION_RETENTION_DAYS=14
ENABLE_PERMANENT_DELETION=false
